{
  "name": "campus-gate-chain",
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "npm run compile && npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "node": "hardhat node",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "deploy:configured": "hardhat run scripts/deploy.js --network configured"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "chai": "^6.3.0",
    "hardhat": "^3.21.2",
    "mocha": "^12.0.0",
    "dotenv": "^16.4.5"
  }
}
